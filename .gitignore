
# Virtual environments
.venv/
venv/

# Python cache
__pycache__/
*.py[cod]
.pytest_cache/

# Local configuration and secrets
.env
.env.*
!.env.example
*.key

# Local SQLite databases and backups
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm

# Generated bulk datasets
data/generated/*

# Keep ground-truth evaluation files
!data/ground_truth/
!data/ground_truth/*.csv

# Keep validation and evaluation reports
!results/validation/
!results/validation/*.csv
!results/validation/*.json

!results/evaluation/
!results/evaluation/*.json
!results/evaluation/*.csv

# Preserve directory structure
!**/.gitkeep

# IDE and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
